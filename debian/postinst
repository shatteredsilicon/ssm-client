#!/bin/bash

if getent passwd ssm > /dev/null 2>&1 && [ -d "/opt/ss" ]; then
    find /opt/ss -path /opt/ss/tool-agent -prune -o -exec chown ssm:ssm {} +
fi
if getent passwd ssm > /dev/null 2>&1 && [ -d "/opt/ss/tool-agent" ]; then
    chown -R root:ssm /opt/ss/tool-agent
fi

# check init system
if [ -d "/run/systemd/system" ]; then
    for file in /opt/ss/ssm-client/systemd/*; do
        if ! [ -f "/lib/systemd/system/$(basename ${file})" ]; then
            mv "${file}" /lib/systemd/system/
        fi
    done

    # backup ssm service files under /etc/systemd/system
    for file in /etc/systemd/system/ssm-{linux,mysql,mongodb,postgresql,proxysql}-metrics.service /etc/systemd/system/ssm-{mysql,mongodb}-queries.service /etc/systemd/system/ssm-mysql-tuning.service; do
        if ! [ -f "$file" ]; then
            continue
        fi

        mv "$file" "${file}.dpkg-old"
    done
elif [ -f "/sbin/upstart-udev-bridge" ] || ([ -f "/sbin/init" ] && [ "$(/sbin/init --version)" == "init (upstart"* ]); then
    for file in /opt/ss/ssm-client/init/*; do
        if ! [ -f "/etc/init/$(basename ${file})" ]; then
            mv "${file}" /etc/init/
        fi
    done
else
    for file in /opt/ss/ssm-client/init.d/*; do
        if ! [ -f "/etc/init.d/$(basename ${file})" ]; then
            mv "${file}" /etc/init.d/
        fi
    done
fi
rm -rf /opt/ss/ssm-client/{systemd,init.d,init}

# install
if [ "$1" == "configure" ] && [ -z "$2" ]; then
    # copy conf files
    for file in /opt/ss/ssm-client/config/*; do
        mv "${file}" /opt/ss/ssm-client/
    done
    for file in /opt/ss/tool-agent/config/*; do
        mv "${file}" /opt/ss/tool-agent/
    done

# upgrade
elif [ "$1" == "configure" ]; then
    # from 9.x going forward, we leave the new config files as .new files
    if ! [ -f /opt/ss/ssm-client/.old-version ] || [[ "$(cat /opt/ss/ssm-client/.old-version)" =~ ^[vV]?[0-8][.] ]]; then
        :
    else
        for file in /opt/ss/ssm-client/config/*; do
            if ! [ -f /opt/ss/ssm-client/${file#/opt/ss/ssm-client/config/} ]; then
                mv "${file}" /opt/ss/ssm-client/
            elif diff -s "$file" /opt/ss/ssm-client/${file#/opt/ss/ssm-client/config/} >/dev/null; then
                :
            else
                mv "${file}" /opt/ss/ssm-client/${file#/opt/ss/ssm-client/config/}.new
            fi
        done

        for file in /opt/ss/tool-agent/config/*; do
            if ! [ -f /opt/ss/tool-agent/${file#/opt/ss/tool-agent/config/} ]; then
                mv "${file}" /opt/ss/tool-agent/
            elif diff -s "$file" /opt/ss/tool-agent/${file#/opt/ss/tool-agent/config/} >/dev/null; then
                :
            else
                mv "${file}" /opt/ss/tool-agent/${file#/opt/ss/tool-agent/config/}.new
            fi
        done
    fi

    ssm-admin upgrade
fi

rm -rf /opt/ss/ssm-client/config
rm -rf /opt/ss/tool-agent/config
